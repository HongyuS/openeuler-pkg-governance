# ---- openEuler release sources ----
# Stable mirror for LTS releases.
OPEN_EULER_MIRROR=https://repo.openeuler.org
# Canonical daily-build / RC host for pre-GA innovation streams (DevStation).
OPEN_EULER_DAILYBUILD=https://dailybuild.openeuler.openatom.cn/dailybuild
OPEN_EULER_ARCH=x86_64
OPEN_EULER_TARGETS=everything
# Pin a specific release instead of auto-discovery (leave blank to auto-detect).
OPEN_EULER_LTS_RELEASE=
OPEN_EULER_INNOVATION_RELEASE=

# ---- activity source (GitCode / AtomGit public API) ----
ACTIVITY_API_BASE=https://api.gitcode.com/api/v5
ACTIVITY_ORG=src-openeuler
# Optional token raises the rate limit (used for larger sweeps).
ACTIVITY_TOKEN=
ACTIVITY_CONCURRENCY=4
# 0 = full scan of every package (default); the activity cache makes reruns incremental.
ACTIVITY_SAMPLE_LIMIT=0

# ---- Ubuntu baseline ----
UBUNTU_ARCHIVE=https://archive.ubuntu.com/ubuntu
UBUNTU_ARCH=amd64
UBUNTU_COMPONENTS=main,universe

# ---- server ----
HOST=127.0.0.1
PORT=8000
DEBUG=1
